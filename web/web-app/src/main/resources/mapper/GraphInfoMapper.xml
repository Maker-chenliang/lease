<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.maker.lease.web.app.mapper.GraphInfoMapper">

    <select id="getRoomGraphList" resultType="com.maker.lease.web.app.vo.graph.GraphVo">
        select id,
               name,
               url
        from lease.graph_info
        where is_deleted = 0
          and item_type = 2
          and item_id = #{id}
    </select>
    <select id="getApartmentGraphList" resultType="com.maker.lease.web.app.vo.graph.GraphVo">
        select id,
               name,
               url
        from lease.graph_info
        where is_deleted = 0
          and item_type = 1
          and item_id = #{id}
    </select>
</mapper>
